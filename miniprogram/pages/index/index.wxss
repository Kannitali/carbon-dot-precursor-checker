.page { padding: 36rpx 28rpx 90rpx; }

.head .h1 { font-size: 42rpx; font-weight: 600; line-height: 1.3; color: #1f2937; }
.head .sub { margin-top: 8rpx; font-size: 25rpx; color: #6b7280; }

.bar { display: flex; align-items: center; gap: 16rpx; margin-top: 40rpx; }
.input {
  flex: 1;
  height: 92rpx;
  padding: 0 26rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #1f2937;
}
.ph { color: #9ca3af; }
.go {
  height: 92rpx;
  padding: 0 34rpx;
  border-radius: 20rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
}

.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }
.chip {
  padding: 10rpx 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #374151;
  font-size: 25rpx;
}
.hint { margin-top: 20rpx; font-size: 23rpx; color: #6b7280; }

.err {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid #fecaca;
  border-radius: 18rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 25rpx;
}
.loading { margin-top: 22rpx; font-size: 25rpx; color: #6b7280; }

.libbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 27rpx;
  color: #374151;
}
.count { display: inline; font-size: 24rpx; color: #6b7280; }
.libgo { font-size: 24rpx; color: #2563eb; }

.localhit {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 1rpx solid #c7d2fe;
  border-radius: 22rpx;
  background: #eef2ff;
}
.lh { font-size: 26rpx; font-weight: 600; color: #3730a3; margin-bottom: 12rpx; }
.li { margin-top: 10rpx; font-size: 24rpx; color: #312e81; line-height: 1.5; }
.lnote { font-size: 22rpx; color: #6b7280; }

.status {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 22rpx;
  background: #ffffff;
}
.status.ok { background: #ecfdf5; border-color: #a7f3d0; }
.status.warn { background: #fffbeb; border-color: #fde68a; }
.status.muted, .status.none { background: #f3f4f6; }
.badge {
  display: inline-block;
  padding: 4rpx 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  color: #1f2937;
}
.status.ok .badge { color: #15803d; }
.status.warn .badge { color: #b45309; }
.stitle { margin-top: 12rpx; font-size: 32rpx; font-weight: 600; color: #1f2937; }
.stext { margin-top: 6rpx; font-size: 26rpx; color: #4b5563; }
.note { margin-top: 12rpx; font-size: 23rpx; color: #b45309; }

.section { margin: 36rpx 0 18rpx; font-size: 25rpx; font-weight: 600; color: #6b7280; }
.paper {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 22rpx;
  background: #ffffff;
}
.ptitle { font-size: 28rpx; font-weight: 600; line-height: 1.5; color: #1f2937; }
.pmeta { margin-top: 8rpx; font-size: 23rpx; color: #6b7280; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 16rpx 0; }
.tag { padding: 4rpx 14rpx; border-radius: 10rpx; background: #f3f4f6; color: #4b5563; font-size: 21rpx; }
.tag.synth { background: #ecfdf5; color: #15803d; }
.tag.detect { background: #fee2e2; color: #b91c1c; }
.act { font-size: 24rpx; color: #2563eb; }

.all { margin: 24rpx 0; font-size: 24rpx; color: #2563eb; text-align: center; }

.help {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  background: #ffffff;
}
.summary { font-size: 27rpx; font-weight: 600; color: #1f2937; }
.helpbody { margin-top: 16rpx; font-size: 24rpx; color: #4b5563; line-height: 1.7; }

.footer {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e5e7eb;
  font-size: 22rpx;
  color: #6b7280;
}
.footer view { margin-bottom: 12rpx; }
