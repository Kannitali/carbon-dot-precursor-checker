.page { padding: 30rpx 28rpx 80rpx; }
.tip {
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #eef2ff;
  color: #3730a3;
  font-size: 24rpx;
  line-height: 1.6;
}
.card {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 22rpx;
  background: #ffffff;
}
.title { font-size: 29rpx; font-weight: 600; color: #1f2937; margin-bottom: 16rpx; }
.hint { font-size: 22rpx; color: #6b7280; line-height: 1.6; }
.field {
  height: 84rpx;
  margin-bottom: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 27rpx;
}
.area {
  width: 100%;
  min-height: 220rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
}
.row { display: flex; gap: 16rpx; margin-top: 18rpx; }
.btn {
  padding: 16rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 27rpx;
  color: #374151;
  background: #f3f4f6;
  flex: 1;
}
.btn.main { background: #2563eb; color: #ffffff; }
.btn.danger { margin-top: 20rpx; background: #fef2f2; color: #b91c1c; }
.empty { font-size: 24rpx; color: #9ca3af; padding: 20rpx 0; }
.item {
  position: relative;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.iname { font-size: 27rpx; font-weight: 600; padding-right: 90rpx; color: #1f2937; }
.imats { margin-top: 6rpx; font-size: 24rpx; color: #4b5563; padding-right: 90rpx; }
.inote { margin-top: 6rpx; font-size: 22rpx; color: #6b7280; }
.del {
  position: absolute;
  right: 0;
  top: 20rpx;
  font-size: 23rpx;
  color: #b91c1c;
}
